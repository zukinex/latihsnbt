# LatihSNBT — Firebase configuration
# Copy this file to .env.local and fill it with YOUR Firebase project's
# web app config (Firebase console > Project settings > Your apps).
# NEVER commit .env.local or any real key. These values are placeholders.
# Without them the app runs in "Soal contoh" mode (hand-written sample
# questions) and shows a "Firebase belum dikonfigurasi" banner.

NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
# Optional:
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# App Check debug provider (local development ONLY).
# Set to "true" to enable the Firebase App Check debug provider on
# localhost. The debug token is printed to the browser console — register
# it in the Firebase console (Security > App Check > Apps > Manage debug
# tokens). NEVER commit a debug token anywhere.
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG=false

# App Check for production: reCAPTCHA Enterprise site key for the web app
# (Firebase console > App Check > Apps > reCAPTCHA Enterprise). Optional;
# without it the app does not initialize App Check, and AI calls work only
# if the project does not enforce App Check.
# NEXT_PUBLIC_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=YOUR_SITE_KEY
